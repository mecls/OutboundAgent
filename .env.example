# ── Supabase (shared Miraside project; OutboundAgent uses outbound_* tables) ──
# Service-role key is server-only — never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public values (safe in the browser). Only needed if a client component reads
# Supabase directly; all writes go through server routes with the service role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── LLM — OpenAI-compatible Chat Completions (Ollama Cloud) ──
# The model MUST support tool/function calling (research + draft force a tool).
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b
# Tiered models (same endpoint/key). HEAVY = research + draft (follows the skill,
# matches proof, honesty-checks). FAST = bulk prose / background. Fall back to LLM_MODEL.
LLM_MODEL_HEAVY=glm-5.2
LLM_MODEL_FAST=gpt-oss:120b
LLM_MAX_TOKENS=10240

# ── Scraping ──
# Apify token (LinkedIn profile scrape). Optional at rest; required for non-dry runs.
APIFY_TOKEN=
# Apify actor that returns LinkedIn PROFILE fields (headline/about/role).
# VERIFY the exact actor id against your Apify account before a real run.
APIFY_LINKEDIN_PROFILE_ACTOR=harvestapi~linkedin-profile
# Apify actor for recent posts (optional "something they posted" hook).
APIFY_LINKEDIN_POSTS_ACTOR=harvestapi~linkedin-profile-posts

# ── Hiring-signal enrichment (the strongest cold-DM hook: "saw you're hiring …") ─
# Both OFF by default (empty = skipped, no extra Apify spend). Set a VERIFIED actor
# id to enable. Adds one Apify call per lead (each) on non-dry runs.
# Company's open JOB POSTS (searched by company name). e.g. bebity~linkedin-jobs-scraper
APIFY_LINKEDIN_JOBS_ACTOR=
# Company POSTS scanned for "we're hiring" language (needs the company's LinkedIn URL,
# resolved from the person's profile). e.g. harvestapi~linkedin-company-posts
APIFY_LINKEDIN_COMPANY_POSTS_ACTOR=
# Jina Reader (r.jina.ai) — website text. Works with NO key (rate-limited).
JINA_API_KEY=

# ── Web search (competitor discovery, geo-scoped) ──
# Works out of the box with NO key (free) via DuckDuckGo. For cleaner, more
# reliable results, set a free Tavily key (1,000/mo, no credit card) at tavily.com.
TAVILY_API_KEY=

# ── Batch / cost control ──
# Hard cap on leads processed per batch run (protects Apify spend).
OUTBOUND_BATCH_CAP=100

# ── App ──
APP_BASE_URL=http://localhost:3000
# Optional shared-password gate for the deployed URL (single-tenant). Leave unset
# to disable the gate entirely.
ACCESS_PASSWORD=

# ── Inngest (prod only; dev uses the local inngest-cli dev server) ──
